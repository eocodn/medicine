FROM python:3.10-slim@sha256:a78e4529630cfe8c5199cafd6e0c28ee1579a13f86274396d8b6b2d80367aa3a

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY browser_ocr/detection/requirements-converter.lock /tmp/requirements-converter.lock
RUN python -m pip install --disable-pip-version-check --no-cache-dir \
      -r /tmp/requirements-converter.lock \
    && rm /tmp/requirements-converter.lock \
    && python -m pip check

WORKDIR /workspace