{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "medicine-ocr-finetune-dataset-v1",
  "title": "Medicine OCR recognition dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "task", "patient_data_policy", "samples_file"],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "task": {"const": "text_recognition"},
    "patient_data_policy": {"const": "forbid"},
    "samples_file": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "image", "image_sha256", "text", "origin", "document_type", "document_id",
        "groups", "semantic_tags", "risk_tags", "privacy", "provenance"
      ],
      "properties": {
        "id": {"type": "string"},
        "image": {"type": "string"},
        "image_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "text": {"type": "string", "minLength": 1},
        "origin": {"enum": ["synthetic", "real_deidentified", "public"]},
        "document_type": {"enum": ["prescription", "medication_bag", "package", "other"]},
        "document_id": {"type": "string"},
        "groups": {
          "type": "object",
          "additionalProperties": false,
          "required": ["layout_family", "source_family", "drug_family"],
          "properties": {
            "layout_family": {"type": "string"},
            "source_family": {"type": "string"},
            "drug_family": {"type": "string"}
          }
        },
        "semantic_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "risk_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contains_patient_data", "deidentified"],
          "properties": {
            "contains_patient_data": {"const": false},
            "deidentified": {"type": "boolean"}
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_id", "license_id"],
          "properties": {
            "source_id": {"type": "string", "minLength": 1},
            "license_id": {"type": "string", "minLength": 1},
            "generator_version": {"type": "string"},
            "source_revision": {"type": "string"}
          }
        }
      }
    }
  }
}
