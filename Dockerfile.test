FROM rust:1.89-slim@sha256:8cffb8fe4e8a95cf0d6a2060375e5a28aff4c752155aa9f1f9193530769bdf66 AS rust-toolchain

FROM python:3.13-slim@sha256:9662417aace5ae7b8e2609cce472b72a8958e134ba372808abe9cc1a0c0125e6

ENV CARGO_HOME=/usr/local/cargo \
    CARGO_TARGET_DIR=/tmp/medicine-target \
    RUSTUP_HOME=/usr/local/rustup \
    RUSTUP_TOOLCHAIN=1.89.0 \
    PATH=/usr/local/cargo/bin:$PATH

COPY --from=rust-toolchain /usr/local/cargo /usr/local/cargo
COPY --from=rust-toolchain /usr/local/rustup /usr/local/rustup
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir cryptography==50.0.0

COPY rust/medicine_core/Cargo.toml rust/medicine_core/Cargo.lock /opt/medicine-rust/
RUN mkdir -p /opt/medicine-rust/src/bin \
    && : > /opt/medicine-rust/src/lib.rs \
    && : > /opt/medicine-rust/src/bin/medicine_agentctl.rs \
    && : > /opt/medicine-rust/src/bin/medicine_core_web.rs \
    && cargo fetch --locked --manifest-path /opt/medicine-rust/Cargo.toml

WORKDIR /app
ENTRYPOINT ["sh", "/app/scripts/test_compose_run.sh"]
