FROM node:22-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436 AS ui-toolchain

WORKDIR /opt/medicine-ui-tools
COPY ui/package.json ui/package-lock.json ./
RUN npm ci

FROM python:3.13-slim@sha256:9662417aace5ae7b8e2609cce472b72a8958e134ba372808abe9cc1a0c0125e6 AS python-toolchain

RUN pip install --no-cache-dir cryptography==50.0.0

FROM rust:1.89-bookworm@sha256:948f9b08a66e7fe01b03a98ef1c7568292e07ec2e4fe90d88c07bb14563c84ff AS rust-toolchain

RUN rustup target add aarch64-linux-android

FROM gradle:9.4.1-jdk17@sha256:549ab76a04fc532f37945d689207a3fb2642350b1235901eb652c93dae218dd0

ENV ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    BUNDLETOOL_JAR=/opt/bundletool/bundletool-all-1.18.3.jar \
    CARGO_HOME=/tmp/cargo-home \
    GRADLE_USER_HOME=/opt/gradle-cache \
    MEDICINE_PYTHON_BIN=/opt/medicine-python/bin/python3.13 \
    MEDICINE_TSC_BINARY=/opt/medicine-ui-tools/node_modules/.bin/tsc \
    MEDICINE_ANDROID_NDK_VERSION=29.0.14206865 \
    RUSTUP_HOME=/usr/local/rustup \
    PATH=/usr/local/cargo/bin:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:$PATH

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates unzip wget \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p "$ANDROID_HOME/cmdline-tools" \
    && wget -q -O /tmp/cmdline-tools.zip https://dl.google.com/android/repository/commandlinetools-linux-13114758_latest.zip \
    && echo "7ec965280a073311c339e571cd5de778b9975026cfcbe79f2b1cdcb1e15317ee  /tmp/cmdline-tools.zip" | sha256sum -c - \
    && unzip -q /tmp/cmdline-tools.zip -d "$ANDROID_HOME/cmdline-tools" \
    && mv "$ANDROID_HOME/cmdline-tools/cmdline-tools" "$ANDROID_HOME/cmdline-tools/latest" \
    && rm /tmp/cmdline-tools.zip \
    && yes | sdkmanager --licenses >/dev/null \
    && sdkmanager "platform-tools" "platforms;android-36" "build-tools;36.0.0" "ndk;${MEDICINE_ANDROID_NDK_VERSION}" \
    && mkdir -p /opt/bundletool \
    && wget -q -O "$BUNDLETOOL_JAR" https://github.com/google/bundletool/releases/download/1.18.3/bundletool-all-1.18.3.jar \
    && echo "a099cfa1543f55593bc2ed16a70a7c67fe54b1747bb7301f37fdfd6d91028e29  $BUNDLETOOL_JAR" | sha256sum -c - \
    && chmod -R a+rX "$ANDROID_HOME"

COPY --from=rust-toolchain /usr/local/cargo /usr/local/cargo
COPY --from=rust-toolchain /usr/local/rustup /usr/local/rustup
COPY --from=ui-toolchain /usr/local/bin/node /usr/local/bin/node
COPY --from=ui-toolchain /opt/medicine-ui-tools/node_modules /opt/medicine-ui-tools/node_modules
COPY --from=python-toolchain /usr/local /opt/medicine-python
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/android

CMD ["gradle", "--no-daemon", "--dependency-verification", "strict", "testDebugUnitTest", "assembleDebug"]
