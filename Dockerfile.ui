FROM rust:1.89-bookworm@sha256:948f9b08a66e7fe01b03a98ef1c7568292e07ec2e4fe90d88c07bb14563c84ff AS rust-toolchain

FROM node:22-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436

ENV CARGO_HOME=/usr/local/cargo \
    CARGO_TARGET_DIR=/tmp/medicine-target \
    HOME=/tmp \
    MEDICINE_CHROMIUM_BINARY=/usr/bin/chromium \
    MEDICINE_STATIC_DIR=/app/ui/dist \
    RUSTUP_HOME=/usr/local/rustup \
    RUSTUP_TOOLCHAIN=1.89.0 \
    PATH=/usr/local/cargo/bin:$PATH

COPY --from=rust-toolchain /usr/local/cargo /usr/local/cargo
COPY --from=rust-toolchain /usr/local/rustup /usr/local/rustup
COPY ui/package.json ui/package-lock.json /opt/medicine-ui-tools/
COPY rust/medicine_core/Cargo.toml rust/medicine_core/Cargo.lock /opt/medicine-rust/
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates chromium fonts-noto-cjk gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/medicine-rust/src/bin \
    && : > /opt/medicine-rust/src/lib.rs \
    && : > /opt/medicine-rust/src/bin/medicine_agentctl.rs \
    && : > /opt/medicine-rust/src/bin/medicine_core_web.rs \
    && cargo fetch --locked --manifest-path /opt/medicine-rust/Cargo.toml \
    && cd /opt/medicine-ui-tools \
    && npm ci \
    && chmod -R a+rX /opt/medicine-ui-tools

WORKDIR /app
ENTRYPOINT ["sh", "/app/scripts/run_ui.sh"]
