FROM rust:1.89-slim@sha256:8cffb8fe4e8a95cf0d6a2060375e5a28aff4c752155aa9f1f9193530769bdf66 AS rust-tools

WORKDIR /build
COPY rust/medicine_core/Cargo.toml rust/medicine_core/Cargo.lock ./
COPY rust/medicine_core/src ./src
RUN cargo build --locked --release --features agentctl,web --bin medicine-agentctl --bin medicine-core-web

FROM debian:trixie-slim@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132

ENV HOME=/tmp \
    MEDICINE_CHROMIUM_BINARY=/usr/bin/chromium \
    MEDICINE_CORE_WEB_BINARY=/usr/local/bin/medicine-core-web \
    MEDICINE_STATIC_DIR=/opt/medicine-static
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*
COPY medicine_app/static /opt/medicine-static
RUN chmod -R a+rX /opt/medicine-static
COPY --from=rust-tools /build/target/release/medicine-agentctl /usr/local/bin/medicine-agentctl
COPY --from=rust-tools /build/target/release/medicine-core-web /usr/local/bin/medicine-core-web

ENTRYPOINT ["/usr/local/bin/medicine-agentctl"]
