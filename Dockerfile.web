FROM node:22-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436 AS ocr-assets

WORKDIR /pipeline/browser_ocr
COPY browser_ocr/package.json browser_ocr/package-lock.json ./
COPY browser_ocr/THIRD_PARTY_NOTICES.md ./
COPY browser_ocr/model-manifest.json ./
COPY browser_ocr/runtime-layout.mjs ./
COPY browser_ocr/parser-export-package.mjs ./
COPY browser_ocr/fetch_assets.mjs ./
COPY browser_ocr/src ./src
RUN npm ci --ignore-scripts --no-audit --no-fund \
    && mkdir -p /downloads \
    && node fetch_assets.mjs /downloads detection
COPY browser_ocr/mobile ./mobile
RUN node mobile/export_runtime.mjs /downloads /out

FROM rust:1.98-slim@sha256:cc0448b41c3b7b7fea44f5dc50eacba729a56db365b65b7bd5e8a82d5b3db078 AS rust-web

WORKDIR /build
COPY rust/medicine_core/Cargo.toml rust/medicine_core/Cargo.lock ./
COPY rust/medicine_core/src ./src
RUN cargo build --locked --release --features web --bin medicine-core-web

FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241

ENV HOME=/tmp \
    MEDICINE_OCR_ASSETS_DIR=/opt/medicine-ocr-assets \
    MEDICINE_REFERENCE_TRUST_MANIFEST=/opt/medicine-reference-trust.json \
    MEDICINE_REFERENCE_UPDATE_BASE_URL=https://pub-539f06de795a469c85ab40570a8634a2.r2.dev/ \
    MEDICINE_STATIC_DIR=/opt/medicine-static

WORKDIR /app

COPY medicine_app/static /opt/medicine-static
COPY deploy/reference-signing-trusted-keys.json /opt/medicine-reference-trust.json
COPY --from=ocr-assets /out /opt/medicine-ocr-assets
RUN chmod -R a+rX /opt/medicine-static /opt/medicine-ocr-assets /opt/medicine-reference-trust.json
COPY --from=rust-web /build/target/release/medicine-core-web /usr/local/bin/medicine-core-web

ENTRYPOINT ["/usr/local/bin/medicine-core-web"]
CMD ["--host", "0.0.0.0", "--port", "8000"]
